#*********************************** DATABASE ******************************************#
# Inside docker compose the host is the service name `postgres`; docker-compose.yml also
# overrides this, so a localhost value here still works for host-side `npm run start:dev`.
DATABASE_URL=postgresql://postgres:ft_pinterest_password123*@postgres:5432/ft_pinterest

#*********************************** AUTH **********************************************#
JWT_SECRET=jwtsecret
# Origin allowed by CORS — where the SPA is actually served from (nginx, port 8443).
FRONTEND_URL=https://localhost:8443
# Port Nest listens on inside the container. Leave 3000 unless nginx changes too.
PORT=3000

#*********************************** CLOUDINARY ****************************************#
CLOUDINARY_CLOUD_NAME=cloudinarycoudname
CLOUDINARY_API_KEY=cloudinaryapikey
CLOUDINARY_API_SECRET=ft_pinterest_api_secret
# publicId of the shared placeholder avatar, so deleting a user never destroys it.
DEFAULT_AVATAR_PUBLIC_ID=avatars/default_avatar

#*********************************** GRAFANA *******************************************#
GRAFANA_ADMIN_USER=grafanaadminuser
GRAFANA_ADMIN_PASSWORD=grafanaadminpassword

#*************************** Google OAuth2 credentials *********************************#
GOOGLE_CLIENT_ID=googleclientid
GOOGLE_CLIENT_SECRET=googleclientsecret
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

#***************************************************************************************#
